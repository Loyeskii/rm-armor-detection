# ── 构建产物 ──────────────────────────────
build/
cmake-build-*/
*.o
*.obj
*.so
*.dll
*.exe
*.pdb
*.ilk

# ── 输入素材：图片与真值入库，视频太大不入库 ──
# 三张图（各约 40 KB）和同名真值 md（各约 2 KB）体积很小，入库后
# 别人 clone 下来直接就能跑 --images，不需要再额外找材料。
data/original/videos/*
!data/original/videos/.gitkeep

# ── 运行产物：程序可重新生成，不入库 ────────
data/processed/**

# ── 网络模型 ──────────────────────────────
# mlp.onnx 只有 314 KB，是"能否跑出号码"的必要材料，必须入库，
# 因此这里**不**忽略 models/ 下的文件。
# 若以后换成几十 MB 的大模型，可改为忽略并用下载脚本替代。

# ── 编辑器 / 系统 ─────────────────────────
.vscode/
.idea/
*.user
.DS_Store
Thumbs.db
